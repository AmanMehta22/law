  "description": "Conduct of proceeding by President and members of District Commission",
  "content": {
    "steps": [
      {
        "order": 1,
        "step": "The President and at least one member of the District Commission conduct the proceeding together"
      },
      {
        "order": 2,
        "step": "If a member is unable to continue, the President and the other member continue the proceeding from the stage at which it was last heard by the previous member"
