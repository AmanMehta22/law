  "title": "Mediation Procedure",
  "description": "Mediator's report submission after unsuccessful mediation",
  "content": {
    "steps": [
      {
        "order": 1,
        "step": "No agreement is reached between the parties within the specified time or the mediator is of the opinion that settlement is not possible"
      },
      {
        "order": 2,
        "step": "The mediator shall prepare his report accordingly"
      },
      {
        "order": 3,
        "step": "The mediator shall submit the report to the concerned Commission"
