  "title": "Settlement Disposal",
  "description": "Disposal of consumer dispute after settlement report",
  "content": {
    "steps": [
      {
        "order": 1,
        "step": "Receipt of the settlement report by the District Commission or the State Commission or the National Commission"
      },
      {
        "order": 2,
        "step": "Passing of a suitable order recording the settlement of consumer dispute within seven days"
      },
      {
        "order": 3,
        "step": "Disposal of the matter accordingly"
      }
    ],
    "authority": "District Commission or State Commission or National Commission",
