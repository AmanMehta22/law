{
  "concept_id": "procedure.mediation_referral",
  "concept_type": "procedure",
  "title": "Mediation Referral",
  "description": "Referral of a complaint to mediation",
  "content": {
    "steps": [
      {
        "order": 1,
        "step": "Parties agree for settlement by mediation and give consent in writing"
      },
      {
        "order": 2,
        "step": "District Commission receives the written consent"
      },
      {
        "order": 3,
        "step": "District Commission refers the matter for mediation within five days of receipt of consent"
      }
    ],
    "authority": "District Commission",
    "documents": [
      "written consent from parties"
    ]
  },
