  "title": "Audit of Central Authority accounts",
  "description": "Audit of accounts of the Central Authority by the Comptroller and Auditor-General of India or appointed person",
  "content": {
    "steps": [
      {
        "order": 1,
        "step": "The Comptroller and Auditor-General of India or any other person appointed by him conducts the audit of the accounts of the Central Authority"
      },
      {
        "order": 2,
        "step": "Demand the production of books, accounts, connected vouchers and other documents and papers"
      },
      {
        "order": 3,
        "step": "Inspect any of the offices of the Central Authority"
      }
