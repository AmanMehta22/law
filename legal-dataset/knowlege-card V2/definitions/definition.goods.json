  "title": "Goods",
  "description": "Definition of Goods under the Consumer Protection Act, 2019",
  "content": {
    "term": "goods",
    "legal_definition": "means every kind of movable property and includes \"food\" as defined in clause (j) of sub-section (1) of section 3 of the Food Safety and Standards Act, 2006;",
    "plain_language": "any type of property that can be moved, including food",
    "examples": [
      "a refrigerator purchased from a store",
      "a packet of biscuits bought from a supermarket"
    ],
    "non_examples": [
      "Not specified in the Act"
    ]
  },
