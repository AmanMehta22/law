  "concept_id": "exception.may_entertain_an_appeal_after_the_expiry_of_the_said_period_",
  "concept_type": "exception",
  "title": "Delayed Appeal",
  "description": "Allowing appeal after 30 days",
  "content": {
    "general_rule": "Every appeal under this section shall be preferred within a period of thirty days",
    "exception": "may entertain an appeal after the expiry of the said period of thirty days",
    "conditions": [
      "the appellant had sufficient cause for not preferring the appeal within the said period of thirty days"
    ]
  },
