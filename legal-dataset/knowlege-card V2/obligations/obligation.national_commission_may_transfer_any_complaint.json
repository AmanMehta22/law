{
  "concept_id": "obligation.national_commission_may_transfer_any_complaint",
  "concept_type": "obligation",
  "title": "National Commission must consider transfer of complaint",
  "description": "The National Commission has the power to transfer complaints between District Commissions or State Commissions",
  "content": {
    "who": "National Commission",
    "what": "may transfer any complaint",
    "conditions": [
      "at any stage of the proceeding",
      "in the interest of justice"
    ],
    "limitations": [
      "on the application of the complainant or of its own motion",
      "pending before the District Commission of one State to a District Commission of another State or before one State Commission to another State Commission"
    ]
  },
