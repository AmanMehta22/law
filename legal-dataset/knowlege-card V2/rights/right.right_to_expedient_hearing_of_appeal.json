{
  "concept_id": "right.right_to_expedient_hearing_of_appeal",
  "concept_type": "right",
  "title": "Right to Expedient Hearing of Appeal",
  "description": "The right to have an appeal heard as expeditiously as possible",
  "content": {
    "right": "Expedient Hearing of Appeal",
    "conditions": [
      "sufficient cause is shown",
      "reasons for grant of adjournment have been recorded in writing"
    ],
    "limitations": [
      "ninety days from the date of its admission"
    ],
    "exceptions": [
      "in the event of an appeal being disposed of after the period so specified"
    ]
  },
