  "concept_id": "right.right_to_file_a_late_complaint",
  "concept_type": "right",
  "title": "Right to File a Late Complaint",
  "description": "The right to file a complaint after the specified period if sufficient cause is shown",
  "content": {
    "right": "File a Late Complaint",
    "conditions": [
      "sufficient cause for not filing the complaint within the period"
    ],
    "limitations": [
      "the period specified in sub-section (1)"
    ],
    "exceptions": [
      "unless the District Commission or the State Commission or the National Commission records its reasons for condoning such delay"
    ]
  },
